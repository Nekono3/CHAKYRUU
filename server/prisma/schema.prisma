generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  // Nullable: org and owner are created together in one transaction
  // (org first, then owner user, then this is backfilled) to break the
  // circular FK between organizations.owner_id and users.organization_id.
  ownerId   String?  @unique @map("owner_id")
  owner     User?    @relation("OrganizationOwner", fields: [ownerId], references: [id])
  users     User[]   @relation("OrganizationUsers")
  events    Event[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String       @map("password_hash")
  organizationId String       @map("organization_id")
  organization   Organization @relation("OrganizationUsers", fields: [organizationId], references: [id])
  ownedOrg       Organization? @relation("OrganizationOwner")
  hostedEvents   Event[]      @relation("EventHost")
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("users")
}

model Template {
  id         String   @id @default(uuid())
  type       String   @default("website")
  category   String
  name       String
  previewUrl String?  @map("preview_url")
  config     Json     @default("{}")
  events     Event[]
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("templates")
}

model Event {
  id             String       @id @default(uuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id])
  hostId         String       @map("host_id")
  host           User         @relation("EventHost", fields: [hostId], references: [id])
  invitationType String       @default("website") @map("invitation_type")
  eventType      String       @map("event_type")
  templateId     String?      @map("template_id")
  template       Template?    @relation(fields: [templateId], references: [id])
  title          String
  eventDate      DateTime     @map("event_date")
  location       Json         @default("{}")
  settings       Json         @default("{}")
  uniqueSlug     String       @unique @map("unique_slug")
  guests         Guest[]
  wishes         Wish[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@map("events")
}

model Guest {
  id         String    @id @default(uuid())
  eventId    String    @map("event_id")
  event      Event     @relation(fields: [eventId], references: [id])
  name       String
  uniqueSlug String    @unique @map("unique_slug")
  rsvpStatus String    @default("pending") @map("rsvp_status")
  viewedAt   DateTime? @map("viewed_at")
  wishes     Wish[]
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("guests")
}

model Wish {
  id        String   @id @default(uuid())
  guestId   String   @map("guest_id")
  guest     Guest    @relation(fields: [guestId], references: [id])
  eventId   String   @map("event_id")
  event     Event    @relation(fields: [eventId], references: [id])
  message   String
  reactions Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("wishes")
}

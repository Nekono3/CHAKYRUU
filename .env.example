# Postgres (used by docker-compose to create the database and by the app to connect)
POSTGRES_USER=chakyruu
POSTGRES_PASSWORD=chakyruu
POSTGRES_DB=chakyruu

# Server
DATABASE_URL=postgresql://chakyruu:chakyruu@localhost:5432/chakyruu?schema=public
JWT_SECRET=replace_with_a_long_random_string
PORT=4000
NODE_ENV=development

# Client (Vite exposes only VITE_ prefixed vars to the browser)
VITE_API_URL=http://localhost:4000/api
